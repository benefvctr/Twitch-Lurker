# Copy to functions/.env and fill in. Do NOT commit the real .env.
# The client secret is NOT set here — it's a Firebase secret (see README):
#   firebase functions:secrets:set TWITCH_CLIENT_SECRET

# Your Twitch application's Client ID (from dev.twitch.tv/console/apps).
TWITCH_CLIENT_ID=your_twitch_client_id

# The public URL where the web app is hosted.
WEB_APP_URL=https://your-firebase-project-id.web.app

# The deployed twitchCallback function URL — must EXACTLY match the OAuth
# Redirect URL you register in the Twitch developer console.
OAUTH_REDIRECT_URI=https://us-central1-your-firebase-project-id.cloudfunctions.net/twitchCallback
